meta {
  name: Remove Tag from Note
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/notes/{{noteId}}/tags/{{tagId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

docs {
  Desasocia una etiqueta de una nota (solo si pertenece al usuario autenticado).

  ## Auth
  Requiere token JWT.

  ## Respuesta
  Devuelve 200 con mensaje de confirmación.
  Devuelve 404 si la relación no existe.
}
