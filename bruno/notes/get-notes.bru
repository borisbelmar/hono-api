meta {
  name: Get Notes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/notes
  body: none
  auth: bearer
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

docs {
  Lista las notas del usuario autenticado con su categoría y etiquetas incluidas.

  ## Auth
  Requiere token JWT en el header Authorization.
}
