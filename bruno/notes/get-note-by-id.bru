meta {
  name: Get Note by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/notes/{{noteId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Retorna el detalle de una nota por su ID (solo si pertenece al usuario autenticado).

  ## Auth
  Requiere token JWT.

  ## Respuesta
  Devuelve 200 con la nota.
  Devuelve 404 si la nota no existe o no pertenece al usuario.
}
