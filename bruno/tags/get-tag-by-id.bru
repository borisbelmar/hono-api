meta {
  name: Get Tag by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/tags/{{tagId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Retorna una etiqueta por su ID.

  ## Auth
  Requiere token JWT.

  ## Respuesta
  Devuelve 404 si no existe.
}
