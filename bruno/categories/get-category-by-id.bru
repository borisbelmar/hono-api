meta {
  name: Get Category by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

docs {
  Retorna una categoría por su ID.

  ## Auth
  Requiere token JWT.

  ## Respuesta
  Devuelve 404 si no existe.
}
