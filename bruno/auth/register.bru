meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Crea una nueva cuenta de usuario.

  ## Body
  - email: Correo electrónico (requerido, formato email)
  - password: Contraseña (requerido, mínimo 8 caracteres)

  ## Respuesta
  Devuelve 201 con un token JWT.
  Devuelve 400 si el body es inválido.
  Devuelve 409 si el email ya está registrado.
}
